# ============================================================
# AgroRent · TractorLink — Variables de entorno (plantilla)
# Copia este archivo como .env  ->  cp .env.example .env
# Vite solo expone al cliente las variables con prefijo VITE_
# ============================================================

# URL base de tu API backend (cuando migres del estado simulado)
VITE_API_URL=http://localhost:4000/api

# --- Opción Supabase ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# ⚠️ NUNCA pongas claves secretas (service_role, contraseñas de BD)
# en variables VITE_: terminan en el bundle público del navegador.
